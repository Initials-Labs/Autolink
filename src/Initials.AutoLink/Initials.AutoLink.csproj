<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <StaticWebAssetBasePath>App_Plugins/Initials.AutoLink</StaticWebAssetBasePath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Initials.AutoLink</PackageId>
    <Version>1.1.0</Version>
    <Authors>Owain Williams</Authors>
    <Company>Owain Williams</Company>
    <Title>Initials.AutoLink for Umbraco</Title>
    <Description>Turns keyword mentions in Umbraco rich text and markdown into links to the corresponding page or external link, at render time, with no editor action required. Stored markup is never modified, so an article picks up a link the day somebody adds the keyword. Keywords live in a backoffice section of their own rather than on your document types, and point at a page or an external URL through Umbraco's Multi URL Picker. Shows which pages carry links and lets individual ones be switched off. Multilingual.</Description>
    <PackageTags>umbraco;umbraco-marketplace;seo;internal-linking;rich-text</PackageTags>
    <PackageReleaseNotes>First stable release. Render-time auto-linking for rich text and Markdown properties, keywords managed in their own backoffice section with page or external destinations, per-culture keyword sets, a dry-run audit with per-page and site-wide suppression, and dependency relations so Umbraco warns before a link target is deleted. Built and verified against Umbraco 17.6.1 on .NET 10.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Initials-Labs/Autolink</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Initials-Labs/Autolink</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 Initials-Labs</Copyright>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateRepositoryUrlAttribute>true</GenerateRepositoryUrlAttribute>
    <PackageIcon>AutolinkLogo.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="AutolinkLogo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="[17.6.1, 18)" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.6.1, 18)" />
    <PackageReference Include="AngleSharp" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Initials.AutoLink.Tests" />
  </ItemGroup>

</Project>
