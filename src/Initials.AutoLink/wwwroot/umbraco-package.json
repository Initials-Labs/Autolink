{
  "$schema": "../../umbraco-package-schema.json",
  "name": "Initials.AutoLink",
  "version": "1.0.0-beta001",
  "allowTelemetry": true,
  "extensions": [
    {
      "type": "localization",
      "alias": "Initials.AutoLink.Localization.enus",
      "name": "Autolink English (en-us)",
      "js": "/App_Plugins/Initials.AutoLink/lang/en.js?v=1.0.0-beta001",
      "meta": {
        "culture": "en-us"
      }
    },
    {
      "type": "localization",
      "alias": "Initials.AutoLink.Localization.engb",
      "name": "Autolink English (en-gb)",
      "js": "/App_Plugins/Initials.AutoLink/lang/en.js?v=1.0.0-beta001",
      "meta": {
        "culture": "en-gb"
      }
    },
    {
      "type": "localization",
      "alias": "Initials.AutoLink.Localization.en",
      "name": "Autolink English (en)",
      "js": "/App_Plugins/Initials.AutoLink/lang/en.js?v=1.0.0-beta001",
      "meta": {
        "culture": "en"
      }
    },
    {
      "type": "section",
      "alias": "Initials.AutoLink.Section",
      "name": "Autolink section",
      "weight": 40,
      "meta": {
        "label": "#initialsAutoLink_sectionName",
        "pathname": "Autolink"
      }
    },
    {
      "type": "dashboard",
      "alias": "Initials.AutoLink.Dashboard.Keywords",
      "name": "Autolink keywords dashboard",
      "element": "/App_Plugins/Initials.AutoLink/autolink-keywords.js?v=1.0.0-beta001",
      "weight": 10,
      "meta": {
        "label": "#initialsAutoLink_dashboardName",
        "pathname": "keywords"
      },
      "conditions": [
        {
          "alias": "Umb.Condition.SectionAlias",
          "match": "Initials.AutoLink.Section"
        }
      ]
    }
  ]
}
